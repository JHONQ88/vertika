{
  "name": "vertika",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=scripts/smoke.mjs --log-level=error && node scripts/smoke.mjs",
    "render": "esbuild scripts/render.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=scripts/render.cjs --log-level=error && node scripts/render.cjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.125",
    "@ai-sdk/groq": "^4.0.86",
    "@vercel/connect": "2.7.0",
    "ai": "^7.0.172",
    "eve": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": ">=24"
  }
}
