# Vértika backend
PORT=8080
RUST_LOG=vertika_backend=debug,tower_http=info,sqlx=warn

# Base de datos PostgreSQL (activa persistencia relacional ACID)
# Sin DATABASE_URL opera en modo demo-memory manteniendo el mismo contrato HTTP
# DATABASE_URL=postgres://vertika:vertika@localhost:5432/vertika

# Autenticación y RBAC (JWT HS256)
# En false permite operar con el perfil demo por defecto si no se envía Bearer; en true exige token en toda ruta /api/v1/*
AUTH_REQUIRED=false
# Cambia AUTH_SECRET por un secreto aleatorio largo en producción
# AUTH_SECRET=cambia-este-secreto-en-produccion

# Orígenes permitidos para CORS en producción (coma-separados; vacío permite cualquier origen en dev)
# CORS_ORIGINS=http://localhost:5173
